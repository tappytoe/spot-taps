{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)",
        ".validate": "$code.matches(/^[A-Z]{4}$/)",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().exists()",
            ".validate": "newData.hasChildren(['name', 'avatar']) && newData.child('name').isString() && newData.child('name').val().length <= 16"
          }
        },
        "actions": {
          "$id": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && data.parent().parent().child('status').val() === 'playing'"
          }
        }
      }
    }
  }
}